# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in your own values:
#      cp .env.example .env
#
#  `.env` is git-ignored. NEVER commit it, and never paste these values in chat.
#  Every key below is YOUR OWN — nothing here is shared with anyone else.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. EMAIL — REQUIRED (this is how the brief reaches you) ═════════════════
#
# Gmail: you must use an "App Password", NOT your normal Google password.
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character code into SMTP_PASS below (spaces are fine to remove)
#
# Not on Gmail? Use your provider's SMTP settings instead, e.g.
#   Outlook  smtp-mail.outlook.com : 587      Fastmail  smtp.fastmail.com : 587
#   iCloud   smtp.mail.me.com      : 587      Yahoo     smtp.mail.yahoo.com : 587

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=                      # ← your 16-char app password goes here
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com          # ← where the brief is delivered (can be a different address)

# The subject line / heading of your brief. Any language.
BRIEF_TITLE=Daily Brief


# ═══ 2. TRANSCRIPTION — OPTIONAL (there is a free fallback) ══════════════════
#
# How episodes get turned into text, in order of preference:
#   1. Free  — existing captions / RSS transcripts        (always tried first)
#   2. Free  — local Whisper on your own machine          (slower; no key needed)
#   3. Paid  — Azure OpenAI speech-to-text                (fast; needs the keys below)
#
# LEAVE THIS WHOLE SECTION BLANK if you don't want to pay for anything.
# It will fall back to local Whisper automatically.
#
# Cost if you do use Azure: roughly $0.30–0.40 per hour of audio.
# Get keys at https://ai.azure.com → create a resource → deploy `gpt-4o-transcribe`.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=          # e.g. https://<your-resource>.openai.azure.com
AZURE_TRANSCRIBE_MODEL=gpt-4o-transcribe

# auto = use Azure if the keys above are set, otherwise local Whisper.
# Force it with: azure | local
TRANSCRIBE_ENGINE=auto

# Local Whisper model size: tiny | base | small | medium | large-v3
# Bigger = more accurate but slower. `small` is a good default; use `large-v3`
# if you listen to a lot of non-English shows.
WHISPER_MODEL=small


# ═══ 3. WRITING THE MEMOS — NO API KEY NEEDED ════════════════════════════════
#
# The actual analysis is done by your AI agent — either Claude Code (on your
# Claude subscription) or Codex CLI (on your ChatGPT subscription). Both read
# the same instructions from AGENTS.md, and ./scripts/daily.sh uses whichever
# you have installed.
#
# There is no ANTHROPIC_API_KEY or OPENAI_API_KEY to set here, and no per-memo
# API charge.
